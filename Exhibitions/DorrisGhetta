<script>
  document.addEventListener("DOMContentLoaded", () => {
  const slidesContainer = document.querySelector(".slides");
  const slides = document.querySelectorAll(".slide");
  const dotsContainer = document.querySelector(".dots-container");
  let captionContainer = document.querySelector(".caption-container");

  if (!slidesContainer || slides.length === 0 || !dotsContainer) return;

  let currentIndex = 0;
  const totalSlides = slides.length;
  let startX = 0;
  let endX = 0;
  const swipeThreshold = 50;

  // Remove any existing caption container and create a new one
  if (captionContainer) {
    captionContainer.remove();
  }
  captionContainer = document.createElement("div");
  captionContainer.classList.add("caption-container");
  slidesContainer.after(captionContainer);
  updateCaption(currentIndex);

  // Create navigation dots
  slides.forEach((slide, index) => {
    const dot = document.createElement("span");
    dot.classList.add("dot");
    if (index === 0) dot.classList.add("active");

    dot.addEventListener("click", () => {
      scrollToSlide(index);
    });

    dotsContainer.appendChild(dot);

    // Hide in-slide captions so only the global caption appears
    const inSlideCaption = slide.querySelector(".caption");
    if (inSlideCaption) {
      inSlideCaption.style.display = "none"; // Hide it instead of removing
    }
  });

  const dots = document.querySelectorAll(".dot");

  function scrollToSlide(index) {
    slidesContainer.scrollTo({
      left: index * slidesContainer.clientWidth,
      behavior: "smooth",
    });

    updateDots(index);
    updateCaption(index);
  }

  function updateDots(index) {
    dots.forEach((dot, i) => {
      dot.classList.toggle("active", i === index);
    });
  }

  function updateCaption(index) {
    const caption = slides[index]?.querySelector(".caption");
    captionContainer.innerHTML = caption ? caption.innerHTML : "";
  }

  // Swipe Detection for Touch Devices
  slidesContainer.addEventListener("touchstart", (e) => {
    startX = e.touches[0].clientX;
  });

  slidesContainer.addEventListener("touchend", (e) => {
    endX = e.changedTouches[0].clientX;
    let swipeDistance = endX - startX;

    if (Math.abs(swipeDistance) > swipeThreshold) {
      if (swipeDistance > 0 && currentIndex > 0) {
        currentIndex--; // Swipe left (previous slide)
      } else if (swipeDistance < 0 && currentIndex < totalSlides - 1) {
        currentIndex++; // Swipe right (next slide)
      }
      scrollToSlide(currentIndex);
    }
  });

  // Ensure perfect snap after manual scrolling
  slidesContainer.addEventListener("scrollend", () => {
    const newIndex = Math.round(slidesContainer.scrollLeft / slidesContainer.clientWidth);
    if (newIndex !== currentIndex) {
      currentIndex = newIndex;
      updateDots(currentIndex);
      updateCaption(currentIndex);
    }
  });
});

</script>
